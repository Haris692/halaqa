# Fonctions LiveKit (copier en supabase/functions/.env pour `npx supabase functions serve`).
# En local : serveur LiveKit de développement (docker, clés devkey/secret).
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# adresse vue depuis le conteneur des fonctions
LIVEKIT_URL=http://host.docker.internal:7880
# adresse donnée aux navigateurs
LIVEKIT_WS_URL=ws://localhost:7880
