{
  "name": "halaqa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "livekit:dev": "docker run -d --name halaqa-livekit --restart unless-stopped -p 127.0.0.1:7880:7880 -p 7881:7881 -p 7882:7882/udp livekit/livekit-server:v1.13.11 --dev --bind 0.0.0.0 --node-ip 127.0.0.1",
    "db:start": "supabase start -x studio,imgproxy,vector,logflare,supavisor,storage-api,postgres-meta",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/services/database.types.ts",
    "import": "node --experimental-strip-types scripts/import-quran-data/index.ts",
    "import:media": "node --experimental-strip-types scripts/import-quran-data/media.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@livekit/components-react": "^2.9.25",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "i18next": "^27.1.1",
    "livekit-client": "^2.24.1",
    "lucide-react": "^1.72.0",
    "perfect-freehand": "^1.2.3",
    "radix-ui": "^1.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^18.0.1",
    "react-router": "^7.18.5",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
